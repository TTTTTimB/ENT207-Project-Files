# 复制为 .env 使用（本地开发 / 云托管环境变量同样适用）

# ---- PostgreSQL 数据库 ----
# 方式一：分项配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ENT207
PG_USER=postgres
PG_PASSWORD=请填写数据库密码
# 云数据库（腾讯云/阿里云/Neon/Supabase 等）通常要求 SSL
PG_SSL=false

# 方式二：直接使用连接串（设置后优先于上面的分项配置）
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- 服务配置 ----
SERVER_PORT=3000
# 生产环境建议限制允许跨域的前端来源（多个用逗号分隔）
# CORS_ORIGIN=https://your-frontend-domain.com
